# ============================================================
# 风调预顺 PHM系统 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# --- 应用配置 ---
APP_NAME=风调预顺-PHM预测性运维系统
DEBUG=false
SECRET_KEY=your-secret-key-change-this-in-production

# --- 数据库配置 ---
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/fengdiao_phm
# 开发环境可使用SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./fengdiao_phm.db

# --- Redis配置 ---
REDIS_URL=redis://localhost:6379/0

# --- JWT配置 ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- 邮件配置 ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@example.com

# --- ERA5气象数据 ---
ERA5_CDS_API_KEY=your-era5-cds-api-key
ERA5_CDS_API_URL=https://cds.climate.copernicus.eu/api

# --- 地图配置 ---
MAPBOX_TOKEN=your-mapbox-token

# --- AI模型配置 ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# --- 阿里百炼配置 ---
DASHSCOPE_API_KEY=your-dashscope-api-key

# --- 企业微信配置 ---
WEIXIN_WEBHOOK_URL=your-weixin-webhook-url
