# ============================================================
# 风调预顺 PHM系统 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# --- 应用配置 ---
APP_NAME=风调预顺-PHM预测性运维系统
DEBUG=false
SECRET_KEY=your-secret-key-change-this-in-production

# --- 数据库配置 ---
# 生产环境使用PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/fengdiao_phm
# 
# 开发环境使用SQLite（推荐）:
# 当 fengdiao_dataset_db_handoff_20260611 文件夹存在时，系统会自动使用离线数据库
DATABASE_URL=sqlite+aiosqlite:///./fengdiao_phm.db

# PostgreSQL连接池配置（仅当使用PostgreSQL时生效）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# --- Redis配置 ---
REDIS_URL=redis://localhost:6379/0

# --- JWT配置 ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- 邮件配置 ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@example.com

# --- ERA5气象数据 ---
ERA5_CDS_API_KEY=your-era5-cds-api-key
ERA5_CDS_API_URL=https://cds.climate.copernicus.eu/api

# --- 地图配置 ---
MAPBOX_TOKEN=your-mapbox-token

# --- AI模型配置 ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# --- 阿里百炼配置 ---
DASHSCOPE_API_KEY=your-dashscope-api-key

# --- 企业微信配置 ---
WEIXIN_WEBHOOK_URL=your-weixin-webhook-url

# ============================================================
# 数据库设置说明：
# 
# 1. SQLite开发环境（推荐给组员）:
#    - 无需安装数据库服务
#    - 确保 fengdiao_dataset_db_handoff_20260611 文件夹与 backend/ frontend/ 同级
#    - 系统会自动检测并使用离线数据库
#    - 默认配置：DATABASE_URL=sqlite+aiosqlite:///./fengdiao_phm.db
# 
# 2. PostgreSQL生产环境:
#    - 需要安装PostgreSQL 14+
#    - 创建数据库: CREATE DATABASE fengdiao_phm;
#    - 创建用户: CREATE USER username WITH PASSWORD 'password';
#    - 授权: GRANT ALL PRIVILEGES ON DATABASE fengdiao_phm TO username;
#    - 配置: DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/fengdiao_phm
# 
# 3. 首次运行:
#    - 运行: python -m scripts.seed_data
#    - 系统会自动创建表并初始化示例数据
# ============================================================