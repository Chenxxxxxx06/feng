        "给YH-A-001的轴承异常创建高优先级工单",
        "给YD-B007建一个维修任务"
      ],
      "required_slots": ["turbine_ref"],
      "optional_slots": ["assignee_name", "fault_keyword", "priority", "title", "description", "cost_estimate", "due_date"],
      "standard_workflow": [
        {"step": "resolve_turbine_by_ref", "type": "read"},
        {"step": "query_turbine_fault_context", "type": "read"},
        {"step": "resolve_personnel_by_name", "type": "read", "optional": true},
        {"step": "draft_workorder_fields", "type": "infer"},
        {"step": "validate_workorder_draft", "type": "validate"},
        {"step": "require_confirmation", "type": "guard"},
        {"step": "create_workorder_record", "type": "write"},
        {"step": "verify_written_entity", "type": "verify"},
        {"step": "present_result", "type": "verify"}
