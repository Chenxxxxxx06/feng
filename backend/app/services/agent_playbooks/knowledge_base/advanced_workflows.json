      "allowed_actions": ["resolve_turbine_by_ref", "query_turbine_fault_context", "resolve_personnel_by_name", "draft_workorder_fields", "create_workorder_record"],
      "final_write_action": "create_workorder_record",
      "confirmation_required": true,
      "confirm_payload": {
        "required_fields": ["turbine_name", "title", "fault_type", "priority", "status", "assignee", "description"],
        "must_show_context": ["fault_context", "turbine_status", "hi_value"]
